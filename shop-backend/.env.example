# Backend environment variables
# Copy this file to .env and fill in the values

# Server port
PORT=3001

# Database Configuration 
# Options: 'dynamodb' or 'local'
DB_TYPE=dynamodb

# AWS Configuration (used if DB_TYPE is 'dynamodb')
AWS_REGION=us-east-2
APPOINTMENTS_TABLE=Appointments
WORKERS_TABLE=Workers

# AWS credentials - Either set them here or use AWS CLI profile
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Local Database Configuration (used if DB_TYPE is 'local')
LOCAL_DB_ENABLED=false
LOCAL_DB_PATH=./data