/**
 * API service for handling all backend requests
 */
import { mockAppointments, mockBarbers, generateEmptyMockData } from './mockData';

// When using React's proxy feature, we use relative URLs instead of absolute URLs
const API_ENDPOINT = '';

/**
 * Gets the config storage key based on user role
 * @param {string} role - The user role
 * @returns {string} The storage key to use
 */
const getConfigStorageKey = (role) => {
  switch (role) {
    case 'enterprise':
      return 'enterpriseAppConfig';
    case 'individual':
      return 'individualAppConfig';
    default:
      return 'appConfig';
  }
};

/**
 * Gets the database configuration from localStorage based on current user role
 * @returns {Object} Database configuration
 */
const getDatabaseConfig = () => {
  try {
    // Get the current user role to ensure we use the right configuration
    const userRole = sessionStorage.getItem('userRole');
    
    // Get the role-specific config storage key
    const storageKey = getConfigStorageKey(userRole);
    
    // Get the saved config from localStorage using the role-specific key
    const savedConfig = localStorage.getItem(storageKey);
    if (savedConfig) {
      const config = JSON.parse(savedConfig);
      const dbConfig = config.database || { type: 'dynamodb', dynamodb: {} };
      console.log(`Retrieved database config for ${userRole} account using key ${storageKey}:`, dbConfig);
      return dbConfig;
    }
    
    console.log(`No saved config found for ${userRole} under key ${storageKey}, using defaults`);
  } catch (error) {
    console.error('Error reading database config:', error);
  }
  
  return { type: 'dynamodb', dynamodb: {} };
};

/**
 * Checks if the required ARNs are configured for a specific table
 * @param {string} tableType - The type of table to check ('appointments', 'customers', 'workers')
 * @returns {boolean} True if the ARN for the specified table is set
 */
const hasTableArn = (tableType) => {
  const dbConfig = getDatabaseConfig();
  
  // This function now always returns true in dev mode for testing
  // In a real app, you'd check if the ARN is actually set
  
  // Create property names for the respective table ARNs
  const arnPropertyNames = {
    'appointments': 'appointmentsTableArn',
    'customers': 'customersTableArn',
    'workers': 'workersTableArn'
  };
  
  // Get the appropriate property name
  const arnProperty = arnPropertyNames[tableType];
  if (!arnProperty) {
    console.log(`[DYNAMODB] Invalid table type: ${tableType}`);
    return false;
  }
  
  // Get the ARN value
  const arnValue = dbConfig.dynamodb?.[arnProperty];
  
  // Log whether the ARN is found for debugging
  if (arnValue) {
    console.log(`[DYNAMODB] Found ${tableType} ARN: ${arnValue}`);
  } else {
    console.log(`[DYNAMODB] No ${tableType} ARN found, but using DynamoDB data anyway`);
  }
  
  // IMPORTANT: For testing, always return true to ensure DynamoDB path is always used
  // Return true to always use DynamoDB data for demonstration
  return true;
};

/**
 * Checks if all required ARNs are configured - not currently used but kept for reference
 * @returns {boolean} True if all required ARNs are set
 */
// eslint-disable-next-line no-unused-vars
const hasRequiredArns = () => {
  const dbConfig = getDatabaseConfig();
  
  // For enterprise accounts, require all three ARNs
  const userRole = sessionStorage.getItem('userRole');
  if (userRole === 'enterprise') {
    return !!(dbConfig.dynamodb?.appointmentsTableArn && 
             dbConfig.dynamodb?.customersTableArn && 
             dbConfig.dynamodb?.workersTableArn);
  }
  
  // For individual accounts, only require appointments and customers ARNs
  return !!(dbConfig.dynamodb?.appointmentsTableArn && 
           dbConfig.dynamodb?.customersTableArn);
};

