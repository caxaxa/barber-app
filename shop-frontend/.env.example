# Frontend environment variables
# Copy this file to .env and fill in the values

# Backend API URL (set this to your backend server URL)
REACT_APP_BACKEND_URL=http://localhost:3001

# This is used as a fallback when there's no API key in the admin configuration
# You can configure the API key in the admin panel under Integrations > OpenAI
REACT_APP_OPENAI_API_KEY=

# Default appointment duration in minutes
REACT_APP_APPOINTMENT_DURATION=40